# Sveltia CMS configuration
# When VITE_CMS_BACKEND=test (the default), the CMS uses an in-browser virtual
# filesystem and no remote repository or authentication is required.
# Set VITE_CMS_BACKEND=github to commit content to a GitHub repository.

VITE_CMS_BACKEND=test

# GitHub backend (required when VITE_CMS_BACKEND=github)
#VITE_CMS_REPO=owner/repo
#VITE_CMS_BRANCH=main

# Optional OAuth client URL for the GitHub authorization code flow. When set,
# `backend.base_url` is configured; otherwise users sign in with a personal
# access token pasted into the CMS UI.
# VITE_CMS_BASE_URL=https://your-oauth-client.example.com
